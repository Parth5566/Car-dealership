PORT=5001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=car_dealership
DB_USER=ncr_wheelz
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_at_least_48_random_characters
APP_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5001
STORAGE_DIR=./storage
# disabled | email (sends through the SMTP settings below) | webhook
RESET_DELIVERY=disabled
# Transactional form emails. Enable after installing dependencies and migrating.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ncrwheelz@gmail.com
SMTP_FROM=ncrwheelz@gmail.com
# Gmail App Password, never your normal account password. Keep server-side.
SMTP_PASS=
EMAIL_RECIPIENTS=ncrwheelz@gmail.com,shivamchaudhary2667@gmail.com
# Sliding 24-hour successful-message cap; excess mail stays queued.
EMAIL_DAILY_LIMIT=400
# Optional Indian car catalog and market comparisons, requested only by valuation.
SCRAPPA_API_KEY=
SCRAPPA_ENABLED=true
# Server-wide upstream attempt caps; cache hits do not spend this allowance.
SCRAPPA_DAILY_LIMIT=15
SCRAPPA_MONTHLY_LIMIT=450
# Optional configured HTTPS webhook. Keep its token server-side. It must deliver reset emails.
# RESET_WEBHOOK_URL=
# RESET_WEBHOOK_TOKEN=
# Set only when every listed proxy overwrites incoming X-Forwarded-For.
# TRUST_PROXY=127.0.0.1/32,::1/128
# COOKIE_SECURE=true

# Optional JSON checklist override; use allowed document type keys only.
# DOCUMENT_REQUIREMENTS_JSON={"passenger":["rc","ownership_authority","insurance","puc"],"commercial":["rc","ownership_authority","insurance","puc","fitness","permit","tax"]}

# Canonical public origin used in search-engine notifications; match NEXT_PUBLIC_SITE_URL.
SITE_URL=https://ncrwheelz.com
# Optional IndexNow key (8-128 letters, numbers, hyphens). Production only; set the
# same value as the frontend INDEXNOW_KEY so /indexnow-key.txt proves ownership.
# INDEXNOW_KEY=
